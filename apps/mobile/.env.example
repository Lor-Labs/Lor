# All variables are required — the app fails fast at startup if any are missing.
# Use your machine's LAN IP (not localhost) so a device/simulator can reach the
# dev servers, e.g. http://192.168.1.20:8080

# Hono API server
EXPO_PUBLIC_API_URL=http://localhost:8080

# Socket.IO realtime gateway
EXPO_PUBLIC_REALTIME_URL=http://localhost:8000

# Web app origin — used to build shareable links (e.g. invites)
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Apple Team ID — only needed for native iOS builds/prebuilds (signs the
# notification-service extension). Find it at developer.apple.com → Account

APPLE_TEAM_ID=
