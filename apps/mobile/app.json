{
  "expo": {
    "name": "Lor",
    "slug": "lor",
    "owner": "lor-chat",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "lor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon-light.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "chat.lor.app",
      "supportsTablet": false,
      "requireFullScreen": true,
      "entitlements": {
        "com.apple.developer.usernotifications.communication": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserActivityTypes": ["INSendMessageIntent"],
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "chat.lor.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "@bacons/apple-targets",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFCF9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0E0D0B",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lor to access your photos and videos so you can share them in messages.",
          "cameraPermission": "Allow Lor to use your camera for video calls and to take photos and videos to share in messages.",
          "microphonePermission": "Allow Lor to use your microphone for calls and for videos you record."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Lor to use your camera for video calls and to take photos and videos to share in messages.",
          "microphonePermission": "Allow Lor to use your microphone for calls and for videos you record."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Lor to show your recent photos so you can attach them to messages.",
          "savePhotosPermission": "Allow Lor to save images from messages to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "react-native-enriched-markdown",
        {
          "enableMath": false
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "133347a1-bcad-424a-ae01-e8c0f6cac0f2"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/133347a1-bcad-424a-ae01-e8c0f6cac0f2"
    }
  }
}
