{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lor",
  "version": "0.5.11",
  "identifier": "com.lor.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter web dev",
    "beforeBuildCommand": "pnpm turbo run build --filter=web"
  },
  "app": {
    "windows": [
      {
        "title": "Lor",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 34
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https://*.lor.chat; connect-src 'self' https://*.lor.chat wss://*.lor.chat https://*.r2.cloudflarestorage.com http://localhost:* ws://localhost:* ipc: http://ipc.localhost; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https://*.lor.chat; font-src 'self' https://*.lor.chat data:; script-src 'self' 'unsafe-inline' https://*.lor.chat"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/Assets.car": "icons/macos/Assets.car"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5MTgyNzYzOEM0OTk1M0UKUldRK2xVbU1ZeWNZT2YwYXhKNHFzNWROUDhHMjRjc2swTlBZNXVPakduWk1SK0RvbE54UTJEQzUK",
      "endpoints": ["https://releases.lor.chat/latest.json"]
    }
  }
}
