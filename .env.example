BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Optional: native Lor channel webhook URL for account signup and waitlist notifications (API only).
# Keep the real URL in deployment secrets; leave blank to disable.
# SIGNUP_WEBHOOK_URL=
DATABASE_URL=postgresql://user:password@localhost:5432/townhall
# Vercel AI Gateway transport. Leave the base URL unset for Vercel's default.
AI_GATEWAY_API_KEY=replace-with-your-vercel-ai-gateway-key
# AI_GATEWAY_BASE_URL=
# Provider-neutral model-role configuration.
LOR_MODEL=moonshotai/kimi-k3
LOR_MODEL_FALLBACKS=thinkingmachines/inkling
LOR_SMALL_MODEL=thinkingmachines/inkling
LOR_SMALL_MODEL_FALLBACKS=moonshotai/kimi-k3
LOR_EMBED_MODEL=alibaba/qwen3-embedding-4b
LOR_EMBED_DIMENSIONS=2560
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_REALTIME_URL=http://localhost:8000
# Public web origin used for share links created by packaged desktop builds.
NEXT_PUBLIC_WEB_URL=https://chat.yourdomain.com
NODE_ENV=development
# Optional backend error tracking (Better Stack Errors application DSN).
# BETTERSTACK_ERRORS_DSN=
# BETTERSTACK_ALERT_WEBHOOK_ID=uuid-of-the-health-channel-webhook
# APP_VERSION=git-commit-sha
PORT=8080
REALTIME_PORT=8000
REDIS_URL=redis://127.0.0.1:6379
SELF_HOSTED=true
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=townhall
S3_REGION=auto
S3_PUBLIC_URL=https://cdn.yourdomain.com
