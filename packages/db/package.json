{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./schema": "./src/schemas/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "node scripts/push.mjs",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/seeds/index.ts",
    "db:backfill-avatar-colors": "tsx src/scripts/backfill-avatar-colors.ts"
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "@repo/utils": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.21.0"
  }
}
