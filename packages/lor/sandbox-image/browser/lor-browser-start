#!/usr/bin/env bash
# The session browser (reference/planned/sandbox-browser-runbook.md): headful
# Chromium on a virtual display, so pages run at a real localhost next to the
# dev servers. Selkies streams the display as H.264 on a Unix socket and
# gateway.mjs relays it to viewers (the live view, the only port meant for a
# preview); CDP stays on 127.0.0.1 for Lor's agent-browser commands. Runs as
# one process; Chromium is restarted when it exits (someone closed the
# window), anything else ends the process so the next ensureProcess starts it
# clean.
set -u

DISPLAY_NUM="${LOR_BROWSER_DISPLAY:-99}"
# The display starts at SIZE; the person in control resizes it to their view,
# up to MAX_SIZE.
SIZE="${LOR_BROWSER_SIZE:-1280x800}"
MAX_SIZE="${LOR_BROWSER_MAX_SIZE:-3840x2400}"
CDP_PORT="${LOR_BROWSER_CDP_PORT:-9222}"
VIEW_PORT="${LOR_BROWSER_VIEW_PORT:-6080}"
# Profile and cache on the workspace disk: the root filesystem's writable
# layer is held in RAM on Blaxel.
DIR="${LOR_BROWSER_DIR:-/workspace/.cache/lor-browser}"

export DISPLAY=":${DISPLAY_NUM}"
mkdir -p "$DIR/profile" "$DIR/logs"

# One browser per sandbox: Lor's lor-browser and the Browser panel both start
# it. Every child inherits the lock, so leftovers of a killed run still hold
# it and the stale-file cleanup below never runs under a live browser.
exec 9>"$DIR/run.lock"
if ! flock -n 9; then
  echo "The browser is already running"
  exit 0
fi

pids=()
chromium_pid=""
cleanup() {
  for pid in "${pids[@]}" $chromium_pid; do kill "$pid" 2>/dev/null; done
  wait 2>/dev/null
}
trap cleanup EXIT
trap 'exit 0' TERM INT

# A display left by a killed run blocks Xvfb from starting.
rm -f "/tmp/.X${DISPLAY_NUM}-lock" "/tmp/.X11-unix/X${DISPLAY_NUM}"

Xvfb "$DISPLAY" -screen 0 "${MAX_SIZE}x24" -nolisten tcp -dpi 96 \
  >"$DIR/logs/xvfb.log" 2>&1 &
pids+=($!)
for _ in $(seq 1 50); do
  xrandr >/dev/null 2>&1 && break
  sleep 0.1
done
xrandr >/dev/null 2>&1 || { echo "Xvfb did not start"; exit 1; }
selkies resize "$SIZE" >/dev/null 2>&1 || echo "Couldn't size the display to $SIZE"

openbox >"$DIR/logs/openbox.log" 2>&1 &
pids+=($!)

# Selkies in secure mode: one token for the person in control, one for
# watchers. Only the gateway holds them; it picks one per viewer, so a
# watcher's input is dropped by Selkies itself.
token() { head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
control_token="$(token)"
watch_token="$(token)"
socket="$DIR/selkies.sock"
rm -f "$socket"
(
  umask 077
  printf '{"%s":{"role":"controller"},"%s":{"role":"viewer"}}' \
    "$control_token" "$watch_token" >"$DIR/selkies-tokens.json"
)
# H.264 in software with 4:4:4 colour; --video-paintover-crf sharpens a
# still screen. JPEG is the fallback for browsers that can't decode H.264
# (Firefox). Everything but video and input is off.
XDG_RUNTIME_DIR=/tmp selkies --unix-socket="$socket" --mode=websockets \
  --master-token="$(token)" --tokens-file="$DIR/selkies-tokens.json" \
  --enable-basic-auth=false --enable-sharing=false --frame-ancestors='*' \
  --encoder=h264enc,jpeg --use-cpu=true --framerate=60 --rate-control-mode=crf \
  --video-crf=23 --video-fullcolor=true --video-paintover-crf=8 \
  --enable-resize=true --mac-cmd-as-ctrl=true --ui-show-sidebar=false \
  --audio-enabled=false --microphone-enabled=false --webcam-enabled=false \
  --gamepad-enabled=false --file-transfers=none --printing-enabled=false \
  --command-enabled=false >"$DIR/logs/selkies.log" 2>&1 &
pids+=($!)

mkdir -p "$DIR/viewers"
LOR_BROWSER_DIR="$DIR" LOR_BROWSER_VIEW_PORT="$VIEW_PORT" \
  LOR_BROWSER_CDP_PORT="$CDP_PORT" LOR_BROWSER_SELKIES_SOCKET="$socket" \
  LOR_BROWSER_CONTROL_TOKEN="$control_token" \
  LOR_BROWSER_WATCH_TOKEN="$watch_token" \
  node /opt/lor-browser/gateway.mjs >"$DIR/logs/gateway.log" 2>&1 &
pids+=($!)

# Blaxel's egress proxy re-signs HTTPS with its own CA, and Chromium trusts
# only its NSS store (not SSL_CERT_FILE): without this every outside site is
# ERR_CERT_AUTHORITY_INVALID. Localhost bypasses the proxy (NO_PROXY).
if [ -n "${SANDBOX_EXTRA_CA_CERTS:-}" ] && [ -f "$SANDBOX_EXTRA_CA_CERTS" ]; then
  nssdb="sql:$HOME/.pki/nssdb"
  mkdir -p "$HOME/.pki/nssdb"
  certutil -d "$nssdb" -L >/dev/null 2>&1 || certutil -d "$nssdb" -N --empty-password
  certutil -d "$nssdb" -A -t "C,," -n sandbox-proxy -i "$SANDBOX_EXTRA_CA_CERTS" \
    || echo "Couldn't trust the sandbox proxy CA; HTTPS sites will fail"
fi

# A profile copied from a stopped run keeps its singleton lock.
rm -f "$DIR/profile/SingletonLock" "$DIR/profile/SingletonSocket" \
  "$DIR/profile/SingletonCookie"

width="${SIZE%x*}"
height="${SIZE#*x}"
# The gateway keeps the window the display's size as it changes.
run_chromium() {
  # --no-sandbox: the sandbox runs as root. --test-type hides the infobar
  # that flags it. There is no GPU, and Chromium blocks software WebGL
  # (SwiftShader) without --enable-unsafe-swiftshader, so WebGL pages break.
  chromium \
    --no-sandbox --test-type --enable-unsafe-swiftshader \
    --disable-dev-shm-usage \
    --no-first-run --no-default-browser-check \
    --disable-session-crashed-bubble --hide-crash-restore-bubble \
    --password-store=basic \
    --remote-debugging-address=127.0.0.1 \
    --remote-debugging-port="$CDP_PORT" \
    --user-data-dir="$DIR/profile" \
    --disk-cache-size=268435456 \
    --window-position=0,0 --window-size="${width},${height}" \
    about:blank >>"$DIR/logs/chromium.log" 2>&1
}

run_chromium &
chromium_pid=$!
while true; do
  wait -n
  if ! kill -0 "$chromium_pid" 2>/dev/null; then
    sleep 1
    run_chromium &
    chromium_pid=$!
    continue
  fi
  echo "A browser service exited; stopping"
  exit 1
done
