{
  "name": "lor",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "dev:all": "turbo run dev",
    "dev:www": "turbo run dev --filter www",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "check-types": "turbo run check-types",
    "generate:auth-schema": "pnpm --filter @repo/auth exec npx @better-auth/cli@latest generate --output ../../packages/db/src/generated-schema.ts",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "mobile:ios": "pnpm --filter mobile exec expo run:ios --device",
    "mobile:sim": "pnpm --filter mobile exec expo run:ios",
    "test": "turbo run test",
    "validate": "pnpm run check && pnpm run check-types && pnpm run test",
    "desktop": "pnpm --filter desktop dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@clack/prompts": "^1.5.0",
    "@types/node": "^24",
    "husky": "^9.1.7",
    "turbo": "^2.8.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    },
    "patchedDependencies": {
      "react-native-enriched-markdown@0.7.4": "patches/react-native-enriched-markdown@0.7.4.patch"
    }
  },
  "engines": {
    "node": "24"
  }
}
